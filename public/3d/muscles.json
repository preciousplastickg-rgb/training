{
 "version": 12,
 "date": "2026-11-09",
 "uv": "TEXCOORD_0 of the twin mesh in twin.glb (MakeHuman UV). Load the maps with texture.flipY = false, like GLTFLoader does.",
 "textures": {
  "normal": {
   "location": "embedded in twin.glb, material Twin_App_glTF -> normalTexture (EXT_texture_webp, quality 95)",
   "resolution": 2048,
   "space": "tangent space, MikkTSpace tangents (exported as TANGENT), +Y up (glTF/OpenGL)",
   "definition": "see body_fat.definition; exported default normalTexture.scale = 0.2",
   "encoding": "WebP quality 95 inside the glb; render vs PNG: PSNR 58.8 dB, 0.003 % of pixels differ by more than 4/255",
   "seams": "relief weakened to 35 % at zone borders (full strength ~12 mm inside), flat at UV seams and joints"
  },
  "id": {
   "file": "twin_id.webp",
   "resolution": 2048,
   "lossless": true,
   "decode": "id = round((R*255 - 20) / 12); R == 0 -> 0 (no zone)",
   "sampling": "NearestFilter, generateMipmaps = false, colorSpace = NoColorSpace (do not sRGB-decode)",
   "cleanup": "islands < 50 texels removed, enclosed holes filled, open r=2 / close r=4 per zone; pec restricted to >= 12 mm below the clavicle line and medial to the deltopectoral groove; deltoid by rule (iteration 11, tools/delt_zones.py): lower border at the deltoid tuberosity, 45 % of the humerus length (upperarm01 -> lowerarm01) below the shoulder joint, V-shaped towards the anterior/posterior edges; front/side/rear = sectors around the humerus axis by origin (clavicle / acromion / spine of the scapula), area shares 32.5 / 40 / 27.5 %; the deltoid wins over biceps, triceps and pectoralis beneath it"
  },
  "flow": {
   "file": "twin_flow.webp",
   "resolution": 2048,
   "lossless": false,
   "decode": "dir = RG*2 - 1: unit fibre direction in tangent space (x along +U, y along +V); B = 1 where a muscle was baked, 0 elsewhere",
   "sampling": "LinearFilter, colorSpace = NoColorSpace",
   "fibres": "not used at runtime any more; source data for twin_fibre (procedural stripes from the flow map alias because 8-bit directions shift the phase by up to 1.6 rad per texel)",
   "smoothing": "per-muscle structure-tensor average (doubled angle, sigma ~3 cm) of the projected long axis; neighbour angle change max 5.5 deg"
  },
  "idsoft": {
   "file": "twin_idsoft.webp",
   "resolution": 2048,
   "lossless": true,
   "decode": "R = soft edge 0..1 (distance to the nearest other zone / 12 mm, 16 levels); G = id of that neighbouring zone, encoded like the ID map (id = round((G*255 - 20) / 12), 0 = none)",
   "sampling": "NearestFilter, generateMipmaps = false, NoColorSpace",
   "blend": "t = 0.5 + 0.5 * R; colour = mix(zoneColour(neighbourId), zoneColour(ownId), t) -> highlight fades over 1.2 cm and stays continuous between two highlighted zones"
  },
  "fibre": {
   "file": "twin_fibre.webp",
   "resolution": 2048,
   "lossless": false,
   "quality": 55,
   "decode": "s = R (0..1); 0.5 = neutral (outside muscles and on UV padding)",
   "sampling": "LinearFilter with mipmaps, colorSpace = NoColorSpace",
   "how": "line integral convolution of noise along the smoothed flow, clipped at muscle borders (streak length ~3 cm, width ~2 mm), high-passed and normalised",
   "use": "colour *= 0.85 + 0.15 * s inside highlighted zones"
  }
 },
 "highlight": {
  "primary": {
   "color": "#D85A30",
   "intensity": 1.0
  },
  "secondary": {
   "color": "#F0997B",
   "intensity": 0.6,
   "formula": "mix(skin, #F0997B, 0.6)"
  },
  "skin": "light grey (0.5 linear)",
  "fibre_contrast": "color *= 0.85 + 0.15 * twin_fibre.r",
  "phase": {
   "source": "manifest.json -> exercises.<id>.phases",
   "multipliers": {
    "con": 1.0,
    "hold": 0.8,
    "ecc": 0.65,
    "top": 0.5
   },
   "applies_to": "primary zones; secondary stay at 0.6",
   "smoothing_ms": 120
  },
  "side": {
   "field": "exercises.<id>.side = \"L\" | \"R\" — only for one-sided exercises (the working side of the athlete); absent = both sides",
   "other_side_factor": 0.35,
   "blend_half_width_m": 0.02,
   "rule": "k = mix(1, mix(other_side_factor, 1, smoothstep(-blend, blend, s * x)), |s|), s = +1 for L, -1 for R, 0 without side; k multiplies the primary and secondary zone weights and the fibre contrast",
   "coordinate": "x = lateral coordinate of the vertex in the bind pose, before skinning (POSITION attribute of twin.glb, metres; +x = athlete's left)",
   "blend": "+-2 cm around the midline x = 0, smooth, no seam"
  }
 },
